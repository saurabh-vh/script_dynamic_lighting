// sunRevolveControllerHTML.js - Classic Lighting & Crisp Shadows
var SunRevolveControllerHTML = pc.createScript('sunRevolveControllerHTML');

// ==========================================
// 1. ATTRIBUTES
// ==========================================

// Sun Orbit
SunRevolveControllerHTML.attributes.add('orbitRadius', { type: 'number', default: 5000, title: 'Orbit Radius' });
SunRevolveControllerHTML.attributes.add('orbitAzimuth', { type: 'number', default: 0, min: 0, max: 360, title: 'Orbit Azimuth' });
SunRevolveControllerHTML.attributes.add('autoIntensity', { type: 'boolean', default: true, title: 'Auto Adjust Intensity' });

// GSplat Lighting
SunRevolveControllerHTML.attributes.add('lightWrap', { type: 'number', default: 0.75, min: 0.0, max: 1.0, title: 'GSplat Light Wrap' });

// Procedural Clouds
SunRevolveControllerHTML.attributes.add('cloudHeight', { type: 'number', default: 1200, title: 'Cloud Altitude' });
SunRevolveControllerHTML.attributes.add('cloudScale', { type: 'number', default: 16000, title: 'Sky Size (Scale)' });
SunRevolveControllerHTML.attributes.add('cloudDensity', { type: 'number', default: 0.5, min: 0.1, max: 0.9, title: 'Cloud Coverage' });
SunRevolveControllerHTML.attributes.add('windSpeed', { type: 'number', default: 0.03, title: 'Wind Speed' });
SunRevolveControllerHTML.attributes.add('volumeLayers', { type: 'number', default: 3, title: '3D Volume Layers' });

// Environment Links
SunRevolveControllerHTML.attributes.add('skyboxEntity', { type: 'entity', title: 'Custom Skybox Entity' });

// Classic Color Palettes
SunRevolveControllerHTML.TWILIGHT_COLOR = new pc.Color(1.0, 0.45, 0.25); 
SunRevolveControllerHTML.NOON_COLOR = new pc.Color(1.0, 0.98, 0.92);     
SunRevolveControllerHTML.TWILIGHT_SKY = new pc.Color(0.15, 0.10, 0.25);  
SunRevolveControllerHTML.NOON_SKY = new pc.Color(0.55, 0.75, 1.0);       

// ==========================================
// 2. INITIALIZATION
// ==========================================
SunRevolveControllerHTML.prototype.initialize = function() {
    this.currentSunPosition = 0.5;
    this.time = 0;
    
    // Cache to prevent micro-stutters
    this.gsplatsCache = this.app.root.findComponents('gsplat');
    this.camerasCache = this.app.root.findComponents('camera');
    
    this.calcSkyColor = new pc.Color();
    this.calcCloudGlow = new pc.Color();
    this.calcSunDir = new pc.Vec3();
    this.sunsetUnderCloud = new pc.Color(0.9, 0.6, 0.4); 
    this.noonUnderCloud = new pc.Color(0.5, 0.6, 0.7);
    
    this.uniformSunColor = new Float32Array(3);
    this.uniformSkyColor = new Float32Array(3);
    this.uniformSunDir = new Float32Array(3);
    this.uniformCloudSunColor = new Float32Array(3);

    // Keep clouds high to avoid intersecting buildings
    if (this.cloudHeight < 800) this.cloudHeight = 1200;

    this.setupGSplatShaders();
    this.setupCloudCanopy();
    this.createHTMLUI();
   
    this.updateSunPosition(this.currentSunPosition);
    console.log("Master Controller Ready! (Manual Shadows Restored)");
};

// ==========================================
// 3. SHADER SETUPS
// ==========================================

// A. GSplat Directional Shader (Classic Math)
SunRevolveControllerHTML.prototype.setupGSplatShaders = function() {
    if (this.gsplatsCache.length === 0) return;

    const shaderLanguage = this.app.graphicsDevice.isWebGPU ? 'wgsl' : 'glsl';
    let customShader = '';

    if (shaderLanguage === 'glsl') {
        customShader = `
            uniform vec3 uSunColor;
            uniform float uSunIntensity;
            uniform vec3 uSunDir; 
            uniform float uLightWrap; 

            void modifySplatCenter(inout vec3 center) {}
            void modifySplatRotationScale(vec3 originalCenter, vec3 modifiedCenter, inout vec4 rotation, inout vec3 scale) {}

            void modifySplatColor(vec3 center, inout vec4 color) {
                vec3 skyAmbient = vec3(0.35, 0.40, 0.50);    
                vec3 groundAmbient = vec3(0.15, 0.15, 0.18); 
                
                float heightFactor = clamp(center.y * 0.05, 0.0, 1.0);
                vec3 baseAmbient = mix(groundAmbient, skyAmbient, heightFactor);

                vec3 pseudoNormal = normalize(center + vec3(0.0, 0.5, 0.0)); 
                float directionalFactor = dot(pseudoNormal, uSunDir) * (1.0 - uLightWrap) + uLightWrap;

                vec3 directLight = uSunColor * (max(0.0, uSunIntensity) * 0.4) * directionalFactor;
                
                vec3 totalLight = baseAmbient + directLight;
                color.rgb *= totalLight;
            }
        `;
    } else {
        customShader = `
            uniform uSunColor: vec3f;
            uniform uSunIntensity: f32;
            uniform uSunDir: vec3f;
            uniform uLightWrap: f32;

            fn modifySplatCenter(center: ptr<function, vec3f>) {}
            fn modifySplatRotationScale(originalCenter: vec3f, modifiedCenter: vec3f, rotation: ptr<function, vec4f>, scale: ptr<function, vec3f>) {}

            fn modifySplatColor(center: vec3f, color: ptr<function, vec4f>) {
                let skyAmbient = vec3f(0.35, 0.40, 0.50);
                let groundAmbient = vec3f(0.15, 0.15, 0.18);
                
                let heightFactor = clamp(center.y * 0.05, 0.0, 1.0);
                let baseAmbient = mix(groundAmbient, skyAmbient, vec3f(heightFactor));
                
                let pseudoNormal = normalize(center + vec3f(0.0, 0.5, 0.0));
                let directionalFactor = dot(pseudoNormal, uniform.uSunDir) * (1.0 - uniform.uLightWrap) + uniform.uLightWrap;
                
                let directLight = uniform.uSunColor * (max(0.0, uniform.uSunIntensity) * 0.4) * directionalFactor;
                let totalLight = baseAmbient + directLight;
                
                *color = vec4f((*color).rgb * totalLight, (*color).a);
            }
        `;
    }

    for (var i = 0; i < this.gsplatsCache.length; i++) {
        var material = this.gsplatsCache[i].material;
        if (material) {
            material.getShaderChunks(shaderLanguage).set('gsplatModifyVS', customShader);
            material.update();
            material.setParameter('uSunColor', [1.0, 1.0, 1.0]);
            material.setParameter('uSunIntensity', 1.0);
            material.setParameter('uSunDir', [0.0, 1.0, 0.0]); 
            material.setParameter('uLightWrap', this.lightWrap); 
        }
    }
};

// B. Procedural FBM Cloud Canopy (Faded Edges)
SunRevolveControllerHTML.prototype.setupCloudCanopy = function() {
    this.cloudPlanes = [];
    const shaderLanguage = this.app.graphicsDevice.isWebGPU ? 'wgsl' : 'glsl';
   
    const glslNoise = `
        float hash(vec2 p) { return fract(1e4 * sin(17.0 * p.x + p.y * 0.1) * (0.1 + abs(sin(p.y * 13.0 + p.x)))); }
        float noise(vec2 x) {
            vec2 i = floor(x); vec2 f = fract(x);
            float a = hash(i); float b = hash(i + vec2(1.0, 0.0));
            float c = hash(i + vec2(0.0, 1.0)); float d = hash(i + vec2(1.0, 1.0));
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
        }
        float fbm(vec2 x) {
            float v = 0.0; float a = 0.5; vec2 shift = vec2(100.0);
            for (int i = 0; i < 4; ++i) { v += a * noise(x); x = x * 2.0 + shift; a *= 0.5; }
            return v;
        }
    `;

    const wgslNoise = `
        fn hash(p: vec2f) -> f32 { return fract(1e4 * sin(17.0 * p.x + p.y * 0.1) * (0.1 + abs(sin(p.y * 13.0 + p.x)))); }
        fn noise(x: vec2f) -> f32 {
            let i = floor(x); let f = fract(x);
            let a = hash(i); let b = hash(i + vec2f(1.0, 0.0));
            let c = hash(i + vec2f(0.0, 1.0)); let d = hash(i + vec2f(1.0, 1.0));
            let u = f * f * (3.0 - 2.0 * f);
            return mix(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
        }
        fn fbm(x_in: vec2f) -> f32 {
            var x = x_in; var v = 0.0; var a = 0.5; let shift = vec2f(100.0);
            for (var i = 0u; i < 4u; i = i + 1u) { v = v + a * noise(x); x = x * 2.0 + shift; a = a * 0.5; }
            return v;
        }
    `;

    let opacityChunk = shaderLanguage === 'glsl' ? `
        uniform float uTime; uniform float uDensity; uniform vec2 uLayerOffset;
        ${glslNoise}
        void getOpacity() {
            vec2 uv = vUv0 * 4.0 + uLayerOffset; uv.x -= uTime;
            float n = fbm(uv);
            float baseAlpha = smoothstep(1.0 - uDensity, 1.0 - uDensity + 0.15, n);
            float dist = distance(vUv0, vec2(0.5));
            float edgeFade = 1.0 - smoothstep(0.25, 0.45, dist);
            dAlpha = baseAlpha * edgeFade;
        }
    ` : `
        uniform uTime: f32; uniform uDensity: f32; uniform uLayerOffset: vec2f;
        ${wgslNoise}
        fn getOpacity() {
            var uv = vUv0 * 4.0 + uniform.uLayerOffset; uv.x = uv.x - uniform.uTime;
            let n = fbm(uv);
            let baseAlpha = smoothstep(1.0 - uniform.uDensity, 1.0 - uniform.uDensity + 0.15, n);
            let dist = distance(vUv0, vec2f(0.5, 0.5));
            let edgeFade = 1.0 - smoothstep(0.25, 0.45, dist);
            dAlpha = baseAlpha * edgeFade;
        }
    `;

    let emissiveChunk = shaderLanguage === 'glsl' ? `
        uniform vec3 uSunColor; uniform vec3 uSkyColor;
        void getEmission() {
            vec2 uv = vUv0 * 4.0 + uLayerOffset; uv.x -= uTime;
            float n = fbm(uv);
            float core = smoothstep(1.0 - uDensity, 1.0, n);
            dEmission = mix(uSunColor, uSkyColor, core * 0.85);
        }
    ` : `
        uniform uSunColor: vec3f; uniform uSkyColor: vec3f;
        fn getEmission() {
            var uv = vUv0 * 4.0 + uniform.uLayerOffset; uv.x = uv.x - uniform.uTime;
            let n = fbm(uv);
            let core = smoothstep(1.0 - uniform.uDensity, 1.0, n);
            dEmission = mix(uniform.uSunColor, uniform.uSkyColor, vec3f(core * 0.85));
        }
    `;

    this.cloudMat = new pc.StandardMaterial();
    this.cloudMat.diffuse = new pc.Color(0, 0, 0);    
    this.cloudMat.blendType = pc.BLEND_NORMAL;
    this.cloudMat.alphaTest = 0.05;
    this.cloudMat.cull = pc.CULL_NONE;
    this.cloudMat.depthWrite = false;

    var dummyTex = new pc.Texture(this.app.graphicsDevice, { width: 1, height: 1, format: pc.PIXELFORMAT_R8_G8_B8_A8 });
    this.cloudMat.opacityMap = dummyTex;
    this.cloudMat.diffuseMap = dummyTex;

    this.cloudMat.chunks[shaderLanguage === 'wgsl' ? 'opacityPS' : 'opacityPS'] = opacityChunk;
    this.cloudMat.chunks[shaderLanguage === 'wgsl' ? 'emissivePS' : 'emissivePS'] = emissiveChunk;
    this.cloudMat.update();

    for (var i = 0; i < this.volumeLayers; i++) {
        var entity = new pc.Entity();
        entity.addComponent("render", { type: "plane", castShadows: true, receiveShadows: true });
        entity.render.material = this.cloudMat;
        entity.setPosition(0, this.cloudHeight + (i * 8), 0);
        entity.setLocalScale(this.cloudScale, 1, this.cloudScale);
       
        this.app.root.addChild(entity);
        this.cloudPlanes.push(entity);
    }
    this.cloudMat.setParameter('uLayerOffset', [0, 0]);
};

// ==========================================
// 4. CORE UPDATES
// ==========================================

SunRevolveControllerHTML.prototype.update = function(dt) {
    if (this.cloudMat) {
        this.time += dt * this.windSpeed;
        this.cloudMat.setParameter('uTime', this.time);
        this.cloudMat.setParameter('uDensity', this.cloudDensity);
    }

    if (this.app.keyboard) {
        var speed = 0.005;
        if (this.app.keyboard.isPressed(pc.KEY_LEFT)) {
            this.slider.value = Math.max(0, this.currentSunPosition - speed) * 100;
            this.onSliderChanged(this.slider.value / 100);
        }
        if (this.app.keyboard.isPressed(pc.KEY_RIGHT)) {
            this.slider.value = Math.min(1, this.currentSunPosition + speed) * 100;
            this.onSliderChanged(this.slider.value / 100);
        }
    }
   
    if (this.lastAzimuth !== this.orbitAzimuth || this.lastWrap !== this.lightWrap || this.lastCloudHeight !== this.cloudHeight) {
        this.lastAzimuth = this.orbitAzimuth;
        this.lastWrap = this.lightWrap;
        this.lastCloudHeight = this.cloudHeight;
        
        for(var i=0; i<this.cloudPlanes.length; i++) {
            this.cloudPlanes[i].setLocalPosition(0, this.cloudHeight + (i * 8), 0);
        }
        this.updateSunPosition(this.currentSunPosition);
    }
};

SunRevolveControllerHTML.prototype.updateSunPosition = function(sliderValue) {
    var val = sliderValue !== undefined ? sliderValue : this.currentSunPosition;
    
    var sunArc = val * Math.PI; 
    var elevation = Math.sin(sunArc);   
    
    var degrees = (val * 180) + 180 + this.orbitAzimuth;
    var radians = degrees * (Math.PI / 180); 
    
    var xPos = Math.cos(radians) * this.orbitRadius;
    var zPos = Math.sin(radians) * this.orbitRadius;
    var yPos = Math.max(elevation * this.orbitRadius * 0.8, -100.0); 
    
    this.entity.setPosition(xPos, yPos, zPos);
    this.entity.lookAt(new pc.Vec3(0, 1, 0));
    
    this.updateLightProperties(elevation);
    this.updateTimeSliderUI();
};

SunRevolveControllerHTML.prototype.updateLightProperties = function(elevation) {
    if (!this.entity.light || !this.autoIntensity) return;
    var light = this.entity.light;
    
    var colorBlend = Math.pow(elevation, 0.6); 
    
    light.intensity = Math.max(0.05, elevation * 2.8);
    light.color.lerp(SunRevolveControllerHTML.TWILIGHT_COLOR, SunRevolveControllerHTML.NOON_COLOR, colorBlend);
    this.calcSunDir.copy(this.entity.forward).mulScalar(-1).normalize();

    this.calcSkyColor.lerp(SunRevolveControllerHTML.TWILIGHT_SKY, SunRevolveControllerHTML.NOON_SKY, colorBlend);
    this.app.scene.ambientLight = this.calcSkyColor;
    this.app.scene.skyboxIntensity = Math.max(0.1, elevation * 1.2);

    this.uniformSunColor[0] = light.color.r; 
    this.uniformSunColor[1] = light.color.g; 
    this.uniformSunColor[2] = light.color.b;
    
    this.uniformSkyColor[0] = this.calcSkyColor.r; 
    this.uniformSkyColor[1] = this.calcSkyColor.g; 
    this.uniformSkyColor[2] = this.calcSkyColor.b;
    
    this.uniformSunDir[0] = this.calcSunDir.x; 
    this.uniformSunDir[1] = this.calcSunDir.y; 
    this.uniformSunDir[2] = this.calcSunDir.z;

    if (this.cloudMat) {
        this.calcCloudGlow.lerp(this.sunsetUnderCloud, this.noonUnderCloud, colorBlend);
        this.uniformCloudSunColor[0] = this.calcCloudGlow.r;
        this.uniformCloudSunColor[1] = this.calcCloudGlow.g;
        this.uniformCloudSunColor[2] = this.calcCloudGlow.b;
        
        this.cloudMat.setParameter('uSunColor', this.uniformCloudSunColor);
        this.cloudMat.setParameter('uSkyColor', this.uniformSkyColor);
    }

    for (var i = 0; i < this.gsplatsCache.length; i++) {
        if (this.gsplatsCache[i].material) {
            this.gsplatsCache[i].material.setParameter('uSunColor', this.uniformSunColor);
            this.gsplatsCache[i].material.setParameter('uSunIntensity', light.intensity);
            this.gsplatsCache[i].material.setParameter('uSunDir', this.uniformSunDir);
            this.gsplatsCache[i].material.setParameter('uLightWrap', this.lightWrap);
        }
    }

    // REMOVED ALL SHADOW DISTANCE OVERRIDES! 
    // The script now perfectly respects the shadow settings you dial into your PlayCanvas Editor.

    if (this.skyboxEntity) {
        var meshComp = this.skyboxEntity.render || this.skyboxEntity.model;
        if (meshComp && meshComp.meshInstances.length > 0 && meshComp.meshInstances[0].material) {
            meshComp.meshInstances[0].material.emissive = this.calcSkyColor;
            meshComp.meshInstances[0].material.emissiveIntensity = Math.max(0.05, elevation * 1.5);
            meshComp.meshInstances[0].material.update();
        }
    }

    for (var c = 0; c < this.camerasCache.length; c++) {
        if(this.camerasCache[c].clearColor) this.camerasCache[c].clearColor = this.calcSkyColor;
    }
};

// ==========================================
// 5. HTML UI
// ==========================================

SunRevolveControllerHTML.prototype.onSliderChanged = function(value) {
    this.currentSunPosition = value;
    this.updateSunPosition(value);
};

SunRevolveControllerHTML.prototype.createHTMLUI = function() {
    this.uiContainer = document.createElement('div');
    this.uiContainer.id = 'sun-control-ui';
    this.uiContainer.style.cssText = `
        position: absolute; bottom: 20px; left: 20px;
        background: rgba(10, 15, 25, 0.85); backdrop-filter: blur(5px);
        color: white; padding: 15px 20px; border-radius: 12px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-width: 400px; z-index: 1000; border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 8px 16px rgba(0,0,0,0.5);
    `;
   
    const title = document.createElement('div');
    title.textContent = '☀️ ENVIRONMENTAL MASTER';
    title.style.cssText = `font-size: 14px; font-weight: 600; text-align: center; color: #E2E8F0; letter-spacing: 1px; margin-bottom: 15px; border-bottom: 1px solid #334155; padding-bottom: 10px;`;
    this.uiContainer.appendChild(title);

    const createControl = (labelText, min, max, val, step, callback) => {
        const wrap = document.createElement('div');
        wrap.style.cssText = `margin-bottom: 15px;`;
        
        const label = document.createElement('div');
        label.textContent = labelText;
        label.style.cssText = `font-size: 12px; font-weight: bold; color: #94A3B8; margin-bottom: 5px;`;
        
        const slider = document.createElement('input');
        slider.type = 'range'; slider.min = min; slider.max = max; slider.step = step; slider.value = val;
        slider.style.cssText = `width: 100%; height: 6px; border-radius: 3px; background: #334155; outline: none; -webkit-appearance: none; cursor: pointer;`;
        
        slider.addEventListener('input', (e) => callback(parseFloat(e.target.value), slider));
        
        wrap.appendChild(label);
        wrap.appendChild(slider);
        this.uiContainer.appendChild(wrap);
        return slider;
    };

    this.timeSlider = createControl('TIME OF DAY', '0', '100', '50', '1', (val) => {
        this.currentSunPosition = val / 100;
        this.updateSunPosition();
    });

    createControl('SHADOW SOFTNESS (LIGHT WRAP)', '0', '100', this.lightWrap * 100, '1', (val) => {
        this.lightWrap = val / 100;
        this.updateSunPosition(); 
    });

    document.body.appendChild(this.uiContainer);
    
    const style = document.createElement('style');
    style.textContent = `
        #sun-control-ui input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none; width: 16px; height: 16px; border-radius: 50%;
            background: #FFF; border: 2px solid #CBD5E1; box-shadow: 0 2px 5px rgba(0,0,0,0.5); cursor: pointer;
        }
    `;
    document.head.appendChild(style);
};

SunRevolveControllerHTML.prototype.updateTimeSliderUI = function() {
    if (!this.timeSlider) return;
    var gradientCenter = (this.currentSunPosition * 100).toFixed(0);
    this.timeSlider.style.background = `linear-gradient(to right, #EA580C 0%, #FBBF24 ${gradientCenter}%, #EA580C 100%)`;
};

SunRevolveControllerHTML.prototype.destroy = function() {
    if (this.uiContainer && this.uiContainer.parentNode) this.uiContainer.parentNode.removeChild(this.uiContainer);
};
