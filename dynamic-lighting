// sunRevolveControllerHTML.js - Attach to Sun entity
var SunRevolveControllerHTML = pc.createScript('sunRevolveControllerHTML');

SunRevolveControllerHTML.attributes.add('orbitRadius', { type: 'number', default: 15, title: 'Orbit Radius' });
SunRevolveControllerHTML.attributes.add('autoIntensity', { type: 'boolean', default: true, title: 'Auto Adjust Intensity' });

// --- NEW: Orbit Orientation ---
SunRevolveControllerHTML.attributes.add('orbitAzimuth', { 
    type: 'number', 
    default: 0, 
    min: 0, 
    max: 360, 
    title: 'Orbit Orientation (Azimuth)',
    description: 'Rotates the suns path (0-360 degrees) to align sunrise/sunset with your custom scene layout.'
});

SunRevolveControllerHTML.attributes.add('skyboxEntity', { 
    type: 'entity', 
    title: 'Custom Skybox Entity', 
    description: 'Link your physical sky dome/box entity here to regulate its material color.' 
});

SunRevolveControllerHTML.attributes.add('lightWrap', { 
    type: 'number', 
    default: 0.75, 
    min: 0.0, 
    max: 1.0, 
    title: 'Light Wrap (Size/Softness)',
    description: 'Higher values make the sun light wrap further around the buildings, making it feel larger and softer.'
});

SunRevolveControllerHTML.TWILIGHT_COLOR = new pc.Color(1.0, 0.45, 0.25); 
SunRevolveControllerHTML.NOON_COLOR = new pc.Color(1.0, 0.98, 0.92);     

SunRevolveControllerHTML.TWILIGHT_SKY = new pc.Color(0.15, 0.10, 0.25);  
SunRevolveControllerHTML.NOON_SKY = new pc.Color(0.55, 0.75, 1.0);       

SunRevolveControllerHTML.prototype.initialize = function() {
    this.currentSunPosition = 0.5;
    this.setupGSplatShaders();
    this.createHTMLUI();
    this.updateSunPosition(this.currentSunPosition);
    console.log("Cinematic Sun - Orbit Orientation Active!");
};

// --- ADVANCED GSPLAT SHADER ---
SunRevolveControllerHTML.prototype.setupGSplatShaders = function() {
    var gsplats = this.app.root.findComponents('gsplat');
    if (gsplats.length === 0) return;

    const isWebGPU = this.app.graphicsDevice.isWebGPU;
    const shaderLanguage = isWebGPU ? 'wgsl' : 'glsl';

    let customShader = '';

    if (shaderLanguage === 'glsl') {
        customShader = `
            uniform vec3 uSunColor;
            uniform float uSunIntensity;
            uniform vec3 uSunDir; 
            uniform float uLightWrap; 

            void modifySplatCenter(inout vec3 center) {}
            void modifySplatRotationScale(vec3 originalCenter, vec3 modifiedCenter, inout vec4 rotation, inout vec3 scale) {}

            void modifySplatColor(vec3 center, inout vec4 color) {
                vec3 skyAmbient = vec3(0.35, 0.40, 0.50);    
                vec3 groundAmbient = vec3(0.15, 0.15, 0.18); 
                
                float heightFactor = clamp(center.y / 20.0, 0.0, 1.0);
                vec3 baseAmbient = mix(groundAmbient, skyAmbient, heightFactor);

                vec3 pseudoNormal = normalize(center + vec3(0.0, 0.5, 0.0)); 
                
                float directionalFactor = dot(pseudoNormal, uSunDir) * (1.0 - uLightWrap) + uLightWrap;

                vec3 directLight = uSunColor * (max(0.0, uSunIntensity) * 0.4) * directionalFactor;
                
                vec3 totalLight = baseAmbient + directLight;
                color.rgb *= totalLight;
            }
        `;
    } else {
        customShader = `
            uniform uSunColor: vec3f;
            uniform uSunIntensity: f32;
            uniform uSunDir: vec3f;
            uniform uLightWrap: f32;

            fn modifySplatCenter(center: ptr<function, vec3f>) {}
            fn modifySplatRotationScale(originalCenter: vec3f, modifiedCenter: vec3f, rotation: ptr<function, vec4f>, scale: ptr<function, vec3f>) {}

            fn modifySplatColor(center: vec3f, color: ptr<function, vec4f>) {
                let skyAmbient = vec3f(0.35, 0.40, 0.50);
                let groundAmbient = vec3f(0.15, 0.15, 0.18);
                
                let heightFactor = clamp(center.y / 20.0, 0.0, 1.0);
                let baseAmbient = mix(groundAmbient, skyAmbient, vec3f(heightFactor));
                
                let pseudoNormal = normalize(center + vec3f(0.0, 0.5, 0.0));
                
                let directionalFactor = dot(pseudoNormal, uniform.uSunDir) * (1.0 - uniform.uLightWrap) + uniform.uLightWrap;
                
                let directLight = uniform.uSunColor * (max(0.0, uniform.uSunIntensity) * 0.4) * directionalFactor;
                let totalLight = baseAmbient + directLight;
                
                *color = vec4f((*color).rgb * totalLight, (*color).a);
            }
        `;
    }

    for (var i = 0; i < gsplats.length; i++) {
        var material = gsplats[i].material;
        if (material) {
            material.getShaderChunks(shaderLanguage).set('gsplatModifyVS', customShader);
            material.update();
            material.setParameter('uSunColor', [1.0, 1.0, 1.0]);
            material.setParameter('uSunIntensity', 1.0);
            material.setParameter('uSunDir', [0.0, 1.0, 0.0]); 
            material.setParameter('uLightWrap', 0.75); 
        }
    }
};

SunRevolveControllerHTML.prototype.updateSunPosition = function(sliderValue) {
    var sunArc = sliderValue * Math.PI; 
    var elevation = Math.sin(sunArc);   
    
    // --- UPDATED: Calculate orbit with the new custom Azimuth offset ---
    var degrees = (sliderValue * 180) + 180 + this.orbitAzimuth;
    var radians = degrees * (Math.PI / 180); 
    
    var xPos = Math.cos(radians) * this.orbitRadius;
    var zPos = Math.sin(radians) * this.orbitRadius;
    
    var yPos = Math.max(elevation * this.orbitRadius * 0.8, 1.0); 
    
    this.entity.setPosition(xPos, yPos, zPos);
    this.entity.lookAt(new pc.Vec3(0, 1, 0));
    
    this.updateLightProperties(elevation);
    this.updateSliderUI(sliderValue, elevation);
};

SunRevolveControllerHTML.prototype.updateLightProperties = function(elevation) {
    if (!this.entity.light || !this.autoIntensity) return;
    
    var light = this.entity.light;
    var colorBlend = Math.pow(elevation, 0.6); 
    
    light.intensity = Math.max(0.05, elevation * 2.8);
    light.color.lerp(SunRevolveControllerHTML.TWILIGHT_COLOR, SunRevolveControllerHTML.NOON_COLOR, colorBlend);

    var sunDir = this.entity.forward.clone().mulScalar(-1).normalize();

    var gsplats = this.app.root.findComponents('gsplat');
    for (var i = 0; i < gsplats.length; i++) {
        var material = gsplats[i].material;
        if (material) {
            material.setParameter('uSunColor', [light.color.r, light.color.g, light.color.b]);
            material.setParameter('uSunIntensity', light.intensity);
            material.setParameter('uSunDir', [sunDir.x, sunDir.y, sunDir.z]); 
            material.setParameter('uLightWrap', this.lightWrap); 
        }
    }

    var skyColor = new pc.Color();
    skyColor.lerp(SunRevolveControllerHTML.TWILIGHT_SKY, SunRevolveControllerHTML.NOON_SKY, colorBlend);

    if (this.skyboxEntity) {
        var meshComponent = this.skyboxEntity.render || this.skyboxEntity.model;
        if (meshComponent && meshComponent.meshInstances.length > 0) {
            var skyMat = meshComponent.meshInstances[0].material;
            if (skyMat) {
                skyMat.emissive = skyColor;
                skyMat.emissiveIntensity = Math.max(0.05, elevation * 1.5); 
                skyMat.update();
            }
        }
    }

    var cameras = this.app.root.findComponents('camera');
    for (var c = 0; c < cameras.length; c++) {
        if(cameras[c].clearColor) {
            cameras[c].clearColor = skyColor;
        }
    }

    this.app.scene.ambientLight = skyColor;
    this.app.scene.skyboxIntensity = Math.max(0.1, elevation * 1.2);
};

// --- UI AND INPUT LOGIC ---

SunRevolveControllerHTML.prototype.onSliderChanged = function(value) {
    this.currentSunPosition = value;
    this.updateSunPosition(value);
};

SunRevolveControllerHTML.prototype.createHTMLUI = function() {
    this.uiContainer = document.createElement('div');
    this.uiContainer.id = 'sun-control-ui';
    this.uiContainer.style.cssText = `
        position: absolute; bottom: 20px; left: 20px;
        background: rgba(10, 15, 25, 0.85); backdrop-filter: blur(5px);
        color: white; padding: 15px; border-radius: 12px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        min-width: 400px; z-index: 1000; border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 0 8px 16px rgba(0,0,0,0.5);
    `;
    
    const title = document.createElement('div');
    title.textContent = '☀️ ENVIRONMENTAL LIGHTING';
    title.style.cssText = `font-size: 14px; font-weight: 600; text-align: center; color: #E2E8F0; letter-spacing: 1px;`;
    
    const sliderContainer = document.createElement('div');
    sliderContainer.style.cssText = `margin: 20px 0 10px 0;`;
    
    this.slider = document.createElement('input');
    this.slider.type = 'range'; this.slider.min = '0'; this.slider.max = '100'; this.slider.value = '50';
    this.slider.style.cssText = `width: 100%; height: 6px; border-radius: 3px; background: #334155; outline: none; -webkit-appearance: none; cursor: pointer;`;
    
    this.slider.addEventListener('input', (e) => this.onSliderChanged(parseInt(e.target.value) / 100));
    
    this.positionLabel = document.createElement('div');
    this.positionLabel.style.cssText = `font-size: 16px; font-weight: bold; text-align: center; margin: 15px 0 5px 0;`;
    
    const timeLabels = document.createElement('div');
    timeLabels.style.cssText = `display: flex; justify-content: space-between; font-size: 11px; font-weight: bold; color: #94A3B8; margin-top: 8px; text-transform: uppercase;`;
    timeLabels.innerHTML = `<span>Sunrise</span><span>Noon</span><span>Sunset</span>`;
    
    sliderContainer.appendChild(this.slider);
    sliderContainer.appendChild(timeLabels);
    
    this.uiContainer.appendChild(title);
    this.uiContainer.appendChild(this.positionLabel);
    this.uiContainer.appendChild(sliderContainer);
    
    document.body.appendChild(this.uiContainer);
    
    const style = document.createElement('style');
    style.textContent = `
        #sun-control-ui input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none; width: 20px; height: 20px; border-radius: 50%;
            background: #FFF; border: 2px solid #CBD5E1; box-shadow: 0 2px 5px rgba(0,0,0,0.5); cursor: pointer;
        }
    `;
    document.head.appendChild(style);
};

SunRevolveControllerHTML.prototype.updateSliderUI = function(timeOfDay, elevation) {
    if (!this.positionLabel) return;
    
    var positionText, color;
    if (timeOfDay < 0.15)      { positionText = "Early Morning"; color = "#FB923C"; }
    else if (timeOfDay < 0.4)  { positionText = "Morning"; color = "#FCD34D"; }
    else if (timeOfDay < 0.6)  { positionText = "Midday"; color = "#FEF08A"; }
    else if (timeOfDay < 0.85) { positionText = "Late Afternoon"; color = "#FCD34D"; }
    else                       { positionText = "Dusk"; color = "#FB923C"; }
    
    this.positionLabel.textContent = positionText;
    this.positionLabel.style.color = color;
    
    var gradientCenter = (timeOfDay * 100).toFixed(0);
    this.slider.style.background = `linear-gradient(to right, #EA580C 0%, #FBBF24 ${gradientCenter}%, #EA580C 100%)`;
};

SunRevolveControllerHTML.prototype.destroy = function() {
    if (this.uiContainer && this.uiContainer.parentNode) this.uiContainer.parentNode.removeChild(this.uiContainer);
};

SunRevolveControllerHTML.prototype.update = function(dt) {
    if (!this.app.keyboard) return;
    var speed = 0.005;
    if (this.app.keyboard.isPressed(pc.KEY_LEFT)) {
        this.slider.value = Math.max(0, this.currentSunPosition - speed) * 100;
        this.onSliderChanged(this.slider.value / 100);
    }
    if (this.app.keyboard.isPressed(pc.KEY_RIGHT)) {
        this.slider.value = Math.min(1, this.currentSunPosition + speed) * 100;
        this.onSliderChanged(this.slider.value / 100);
    }
    
    // Auto-update if azimuth is changed in editor during runtime
    if (this.lastAzimuth !== this.orbitAzimuth) {
        this.lastAzimuth = this.orbitAzimuth;
        this.updateSunPosition(this.currentSunPosition);
    }
};
